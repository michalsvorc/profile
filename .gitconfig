#===============================================================================
# User
#===============================================================================

[user]
  email = dev@michalsvorc.com
  name = Michal Svorc

#===============================================================================
# Aliases
#===============================================================================

[alias]
  c  = commit
  cc = checkout
  cl = clone
  d  = diff
  ds = diff --staged
  dt = difftool
  l  = log --graph --pretty=format:'%Cred%h%Creset -%C(yellow)%d%Creset %s %Cgreen(%cr: %cd) %C(bold blue)<%ae>%Creset' --abbrev-commit --date=iso
  r  = restore
  rs = restore --staged
  s  = status --short
  sw = switch

#===============================================================================
# Main
#===============================================================================

[core]
  pager = bat --plain
  editor = $EDITOR

[init]
  defaultBranch = main

[pull]
  rebase = false

[help]
  autocorrect = 30

[commit]
  verbose = true

#===============================================================================
# Diff
#===============================================================================

[diff]
  tool = nvim_diff
  colorMoved = default

[difftool]
  prompt = false
  colorMoved = default

[difftool "nvim_diff"]
  cmd = nvim -d "$LOCAL" "$REMOTE"

#===============================================================================
# Merge
#===============================================================================

[merge]
  tool = nvim_merge
  conflictstyle = diff3

[mergetool]
  prompt = false
  keepBackup = false

[mergetool "nvim_merge"]
  cmd = nvim -d "$LOCAL" "$REMOTE" "$MERGED"
